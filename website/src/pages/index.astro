---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/Hero.astro';
import Ascension from '../components/Ascension.astro';
import Arsenal from '../components/Arsenal.astro';
import Catalog from '../components/Catalog.astro';
import ReleaseNotes from '../components/ReleaseNotes.astro';
import Download from '../components/Download.astro';
import ItemDialog from '../components/ItemDialog.astro';
---
<SiteLayout title="超限武装 v0.1.1 · 单机版 — OVERFORGED" description="超限武装 Overforged：Dota 2 本地装备补丁。探索融合神装、永久吸收能力与完整升级数值。" multiplayer={false}>
  <main id="main" class="singleplayer-page">
    <Hero />
    <Ascension />
    <Arsenal />
    <Catalog />
    <ReleaseNotes />
    <Download />
  </main>
  <ItemDialog />
</SiteLayout>
